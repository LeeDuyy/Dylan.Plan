# ============================================================================
# dylan-ssr-kit — cấu hình dự án
# ----------------------------------------------------------------------------
# Copy file này thành `.env` ở gốc plugin (hoặc gốc repo đích) rồi chỉnh path.
# Mọi skill và hook đều đọc cấu hình từ đây; KHÔNG hardcode path trong SKILL.md.
#
# Quy ước:
#   - Path tương đối  => tính từ SSR_PROJECT_ROOT.
#   - Path tuyệt đối  => dùng nguyên văn.
#   - Dùng dấu `/` kể cả trên Windows.
#   - `${VAR}` được nội suy từ biến khai báo TRƯỚC đó trong chính file này.
# ============================================================================

# ─── 1. Dự án ───────────────────────────────────────────────────────────────
SSR_PROJECT_NAME=DylanPlan
SSR_PROJECT_ROOT=C:\Data\SourceCode\Dylan.Plan
# Ngôn ngữ artifact: vi | en
SSR_OUTPUT_LANGUAGE=vi
# Mã function: <PREFIX>-### (VD: FNC-014)
SSR_FEATURE_CODE_PREFIX=US

# ─── 2. Knowledge base — BA ─────────────────────────────────────────────────
# BẮT BUỘC có đủ cả RAW và WIKI. Hook `guard-artifact-path` sẽ chặn nếu thiếu.
SSR_BA_KB_ROOT=docs/kb/ba
SSR_BA_KB_RAW=${SSR_BA_KB_ROOT}/raw
SSR_BA_KB_WIKI=${SSR_BA_KB_ROOT}/wiki
SSR_BA_KB_INDEX=${SSR_BA_KB_ROOT}/00-index.md
# Business Flow + định hướng sản phẩm, do ssr-po chốt với user và lưu vào tri thức BA
SSR_BUSINESS_FLOW=${SSR_BA_KB_ROOT}/business-flow.md

# ─── 3. Knowledge base — DEV ────────────────────────────────────────────────
# BẮT BUỘC có đủ cả RAW và WIKI.
SSR_DEV_KB_ROOT=docs/kb/dev
SSR_DEV_KB_RAW=${SSR_DEV_KB_ROOT}/raw
SSR_DEV_KB_WIKI=${SSR_DEV_KB_ROOT}/wiki
SSR_DEV_KB_INDEX=${SSR_DEV_KB_ROOT}/00-index.md

# ─── 4. Artifact theo feature ───────────────────────────────────────────────
SSR_FEATURE_ROOT=docs/features
SSR_REQUIREMENTS_INDEX=docs/requirements-index.md
# Nơi lưu bản review cấp sản phẩm của ssr-po
SSR_PO_REVIEW_ROOT=docs/po
# Nơi lưu mockup/wireframe được AC và Screen Element tham chiếu
SSR_MOCKUP_ROOT=docs/mockups

# ─── 5. Memory dự án ────────────────────────────────────────────────────────
# 5 file bắt buộc: rules.md, language.md, decisions.md, judgement-log.md, glossary.md
SSR_MEMORY_ROOT=docs/memory
SSR_MEMORY_RULES=${SSR_MEMORY_ROOT}/rules.md
SSR_MEMORY_LANGUAGE=${SSR_MEMORY_ROOT}/language.md
SSR_MEMORY_DECISIONS=${SSR_MEMORY_ROOT}/decisions.md
SSR_MEMORY_JUDGEMENTS=${SSR_MEMORY_ROOT}/judgement-log.md
SSR_MEMORY_GLOSSARY=${SSR_MEMORY_ROOT}/glossary.md

# ─── 6. Data model (Prisma + SQLite + DBML) ─────────────────────────────────
SSR_DBML_FILE=docs/db/schema.dbml
SSR_DBML_ERD=docs/db/erd.md
SSR_PRISMA_SCHEMA=prisma/schema.prisma
SSR_PRISMA_MIGRATIONS_DIR=prisma/migrations
SSR_PRISMA_SEED=prisma/seed.ts
SSR_SQLITE_FILE=prisma/dev.db
# Provider luôn là sqlite cho kit này
SSR_DB_PROVIDER=sqlite

# ─── 7. Source layout Next.js ───────────────────────────────────────────────
SSR_APP_DIR=src/app
SSR_COMPONENTS_DIR=src/components
SSR_LIB_DIR=src/lib
SSR_SERVER_DIR=src/server
SSR_TEST_DIR=tests
SSR_NEXT_ROUTER=app

# ─── 8. Lệnh verification ───────────────────────────────────────────────────
# Skill chạy đúng các lệnh này; đổi ở đây là đổi cho toàn bộ kit.
SSR_CMD_INSTALL=rtk pnpm install
SSR_CMD_TYPECHECK=rtk tsc --noEmit
SSR_CMD_LINT=rtk lint
SSR_CMD_TEST=rtk vitest run
SSR_CMD_BUILD=rtk next build
SSR_CMD_PRISMA_VALIDATE=rtk npx prisma validate
SSR_CMD_PRISMA_FORMAT=rtk npx prisma format
SSR_CMD_PRISMA_MIGRATE=rtk npx prisma migrate dev
SSR_CMD_PRISMA_MIGRATE_DEPLOY=rtk npx prisma migrate deploy
SSR_CMD_PRISMA_GENERATE=rtk npx prisma generate
# Sinh DBML từ schema.prisma (prisma-dbml-generator)
SSR_CMD_DBML_GENERATE=rtk npx prisma generate

# ─── 9. Chính sách hook artifact ────────────────────────────────────────────
# guard    : chặn sai vị trí ghi, cảnh báo thiếu section  (mặc định)
# strict   : chặn cả sai vị trí lẫn thiếu section bắt buộc
# advisory : chỉ ghi log, không chặn
SSR_HOOK_MODE=guard
SSR_HOOK_LOG=.claude/ssr-artifact.log
# Bật/tắt hook mà không cần gỡ khỏi settings
SSR_HOOK_ENABLED=true

# ─── 10. Giới hạn quy trình ─────────────────────────────────────────────────
SSR_FIX_ROUND_LIMIT=2
SSR_MAX_TASKS_PER_FEATURE=40
# Cho phép skill tự trả lời câu hỏi raw từ memory/wiki thay vì hỏi lại user
SSR_AUTO_ANSWER_FROM_MEMORY=true

# ─── 11. Pipeline ───────────────────────────────────────────────────────────
# File lưu tiến trình pipeline để hiển thị step trên console
SSR_PIPELINE_STATE=.claude/ssr-pipeline-state.json
# Chỉ artifact báo cáo duy nhất là report.md cuối pipeline.
# Findings của review và nội dung fix round được gộp vào report cuối.
SSR_SINGLE_REPORT=true
# Pipeline chạy BA -> DEV -> TEST. ssr-po KHÔNG nằm trong pipeline.
SSR_PIPELINE_PHASES=ba,dev,test
# Chạy song song stage `review` và stage `test` trong phase TEST
SSR_PARALLEL_TEST=true
# Trần số file mỗi stage được đọc, để tránh nạp ngữ cảnh thừa.
# Vượt trần => thu hẹp phạm vi hoặc giao cho agent chuyên trách.
SSR_CONTEXT_BUDGET_FILES=12
# Trần số file cho agent con (ba-expert / po-expert / swe-expert)
SSR_AGENT_BUDGET_FILES=8

# ─── 12. Chất lượng spec (chạy ngầm, không ghi vào spec) ────────────────────
SSR_SPEC_QUALITY_LOG=.claude/ssr-spec-quality.log
# Ngưỡng INVEST-Small: số AC tối đa trước khi khuyến nghị tách story
SSR_INVEST_MAX_AC=8
# Thuật ngữ khó hiểu bị cấm trong spec, phân tách bằng dấu phẩy.
# Spec phải diễn đạt tường minh thay vì dùng các từ này.
SSR_JARGON_DENYLIST=idempotent,debounce,throttle,upsert,cascade,orchestration,middleware,payload,serialize,deserialize,polymorphic,denormalize,eventual consistency,race condition,memoization,hydration

# ─── 13. Executor implement ─────────────────────────────────────────────────
# claude : ssr-dev tự viết code (giao swe-expert theo điều kiện định lượng có sẵn)
# codex  : ssr-dev soạn brief từ task.md/plan.md rồi giao TOÀN BỘ việc viết
#          code cho Codex CLI qua Bash — dùng để tối ưu chi phí khi user đã có
#          Codex. ssr-dev vẫn tự chạy verification, đối chiếu phạm vi sửa đổi
#          và cập nhật task.md/plan.md/wiki — Codex không có quyền ghi các
#          artifact đó (xem DEC-023, skills/ssr-dev/SKILL.md mục "Khi
#          SSR_IMPLEMENT_EXECUTOR=codex").
SSR_IMPLEMENT_EXECUTOR=codex
# Lệnh gọi Codex CLI không tương tác, tự duyệt thay đổi (điều chỉnh flag theo
# đúng bản Codex CLI đã cài — cú pháp có thể khác giữa các phiên bản).
# ssr-dev gọi: ${SSR_CMD_CODEX} "$(cat <đường-dẫn-brief-tạm>)"
SSR_CMD_CODEX=codex exec --yolo